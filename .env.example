# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# Make.com webhook-URL (Scenario > Webhooks > Custom webhook)
MAKE_WEBHOOK_URL=

# Gedeeld geheim (API key): dezelfde waarde als de API key in de Make-webhook
# (wordt als header "x-make-apikey" meegestuurd; Make weigert berichten zonder)
MAKE_WEBHOOK_SECRET=

# Publieke basis-URL van deze app (widget.js en iframe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI-hulp (zie docs/ai.md). Standaard UIT. -------------------------------------------------
# off (standaard) | openai | fake (nepaanbieder voor tests, geen kosten)
# AI_PROVIDER=off
# Alleen bij AI_PROVIDER=openai. Maak de sleutel zelf, met een lage bestedingslimiet; zet hem alleen hier en in Vercel (Sensitive).
# OPENAI_API_KEY=
# Model (standaard gpt-4o-mini); controleer de actuele naam en prijs in het OpenAI-dashboard.
# AI_MODEL=
# Maximaal aantal AI-aanroepen per dag (UTC), als kostenplafond. Standaard 20.
# AI_DAILY_LIMIT=20

# --- Bescherming tegen misbruik (zie docs/abuse-protection.md) -------------------------------
# Gedeelde teller (Upstash Redis, REST). Zonder deze twee gelden de limieten per serverinstantie en
# zijn ze dus zwak op Vercel. (De Vercel-integratie zet KV_REST_API_URL/TOKEN; die worden ook gelezen.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (botcontrole). Zet beide of geen van beide.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optioneel: eigen geheim voor het formuliertoken (anders afgeleid van MAKE_WEBHOOK_SECRET)
# FORM_TOKEN_SECRET=

# Optioneel: limieten (standaardwaarden tussen haakjes)
# RL_IP_MAX=5                    # aanvragen per IP per venster
# RL_IP_WINDOW_SECONDS=600
# RL_EMAIL_MAX=3                 # aanvragen per e-mailadres per uur
# DUPLICATE_WINDOW_SECONDS=86400 # zelfde persoon + woning
# MAX_APPLICATIONS_PER_DAY=30    # totaal per dag; beschermt de Make-quota
# FORM_MIN_SECONDS=8             # sneller ingevuld = bot

# --- Supabase: opslag en dashboard voor de makelaar (zie docs/plan-fase-2.md) ---------------
# Publieke gegevens (staan in de browser): project-URL en de publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GEHEIM, alleen op de server (Vercel: Sensitive). Gebruikt om een aanvraag op te slaan.
# Supabase dashboard > Project Settings > API Keys > secret key (sb_secret_...). Nooit in de browser of in git.
SUPABASE_SECRET_KEY=
# Optioneel: ander project-URL alleen voor de server (anders wordt NEXT_PUBLIC_SUPABASE_URL gebruikt).
# NEXT_PUBLIC_* wordt bij het bouwen vastgelegd; SUPABASE_URL wordt tijdens het draaien gelezen.
# SUPABASE_URL=

# Publieke basis-URL van de app, voor de link "Open in dashboard" in de mail
# NEXT_PUBLIC_APP_URL=https://rentalflowai.vercel.app
# Optioneel, alleen voor de server en tijdens het draaien gelezen (heeft voorrang):
# APP_URL=https://rentalflowai.vercel.app
