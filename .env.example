# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# Make.com webhook-URL (Scenario > Webhooks > Custom webhook)
MAKE_WEBHOOK_URL=

# Gedeeld geheim (API key): dezelfde waarde als de API key in de Make-webhook
# (wordt als header "x-make-apikey" meegestuurd; Make weigert berichten zonder)
MAKE_WEBHOOK_SECRET=

# Publieke basis-URL van deze app (widget.js en iframe)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fase 2 (nog niet nodig)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Bescherming tegen misbruik (zie docs/abuse-protection.md) -------------------------------
# Gedeelde teller (Upstash Redis, REST). Zonder deze twee gelden de limieten per serverinstantie en
# zijn ze dus zwak op Vercel. (De Vercel-integratie zet KV_REST_API_URL/TOKEN; die worden ook gelezen.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (botcontrole). Zet beide of geen van beide.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optioneel: eigen geheim voor het formuliertoken (anders afgeleid van MAKE_WEBHOOK_SECRET)
# FORM_TOKEN_SECRET=

# Optioneel: limieten (standaardwaarden tussen haakjes)
# RL_IP_MAX=5                    # aanvragen per IP per venster
# RL_IP_WINDOW_SECONDS=600
# RL_EMAIL_MAX=3                 # aanvragen per e-mailadres per uur
# DUPLICATE_WINDOW_SECONDS=86400 # zelfde persoon + woning
# MAX_APPLICATIONS_PER_DAY=30    # totaal per dag; beschermt de Make-quota
# FORM_MIN_SECONDS=8             # sneller ingevuld = bot
